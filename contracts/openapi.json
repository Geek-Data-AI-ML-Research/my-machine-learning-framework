{
  "components": {
    "schemas": {
      "FeatureFlags": {
        "additionalProperties": false,
        "properties": {
          "cloud_runners": {
            "default": false,
            "title": "Cloud Runners",
            "type": "boolean"
          },
          "git_sync": {
            "default": false,
            "title": "Git Sync",
            "type": "boolean"
          },
          "kaggle_sync": {
            "default": false,
            "title": "Kaggle Sync",
            "type": "boolean"
          },
          "mcp_oauth": {
            "default": false,
            "title": "Mcp Oauth",
            "type": "boolean"
          },
          "night_shift": {
            "default": false,
            "title": "Night Shift",
            "type": "boolean"
          }
        },
        "title": "FeatureFlags",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "default": "mymlfw-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "additionalProperties": false,
        "properties": {
          "org": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrgResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Persona"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "user"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "OrgEntitlements": {
        "additionalProperties": false,
        "properties": {
          "advise_per_day": {
            "default": 20,
            "title": "Advise Per Day",
            "type": "integer"
          },
          "max_agents": {
            "default": 2,
            "title": "Max Agents",
            "type": "integer"
          },
          "max_cloud_micros_day": {
            "default": 0,
            "title": "Max Cloud Micros Day",
            "type": "integer"
          },
          "max_llm_cost_micros_day": {
            "default": 5000000,
            "title": "Max Llm Cost Micros Day",
            "type": "integer"
          },
          "max_private_projects": {
            "default": 5,
            "title": "Max Private Projects",
            "type": "integer"
          }
        },
        "title": "OrgEntitlements",
        "type": "object"
      },
      "OrgResponse": {
        "additionalProperties": false,
        "properties": {
          "entitlements": {
            "$ref": "#/components/schemas/OrgEntitlements"
          },
          "feature_flags": {
            "$ref": "#/components/schemas/FeatureFlags"
          },
          "id": {
            "maxLength": 40,
            "minLength": 4,
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "plan": {
            "default": "dev",
            "title": "Plan",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "OrgResponse",
        "type": "object"
      },
      "PersonaSwitchRequest": {
        "additionalProperties": false,
        "properties": {
          "persona": {
            "enum": [
              "owner",
              "member",
              "viewer",
              "agent"
            ],
            "title": "Persona",
            "type": "string"
          }
        },
        "required": [
          "persona"
        ],
        "title": "PersonaSwitchRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "default": "dev",
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "TokenResponse": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "org_id": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 4,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user_id": {
            "maxLength": 40,
            "minLength": 4,
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "user_id"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserResponse": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "maxLength": 40,
            "minLength": 4,
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "mymlfw Campaign SaaS API",
    "version": "0.1.0"
  },
